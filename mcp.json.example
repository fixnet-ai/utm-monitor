# MCP config for utmm — copy to ~/.claude/mcp.json or run:
#   claude mcp add utmm --url http://127.0.0.1:2121/mcp
#
# Host must be running: sudo utmm --host
# v0.3.0 merged MCP into the unified HTTP server on port 2121.

{
  "mcpServers": {
    "utmm": {
      "type": "streamableHttp",
      "url": "http://127.0.0.1:2121/mcp"
    }
  }
}
