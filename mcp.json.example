# MCP Server Configuration for utmm
# =============================================================================
# This file lets Claude Code (or any MCP client) control UTM VMs via the utmm
# stdio MCP interface.  utmm --mcp handles auto-ensure (starts Host service if
# not running), so no separate daemon management is needed.
#
# PREREQUISITES
# -----------------------------------------------------------------------------
# 1. utmm binary must be installed and executable:
#       which utmm   # should print /opt/utmm/utmm (or C:\opt\utmm\utmm.exe)
#
# 2. Passwordless sudo for the utmm binary:
#       sudo -n /opt/utmm/utmm --version   # must succeed without password prompt
#
# QUICK INSTALL (Claude Code)
# -----------------------------------------------------------------------------
# Option A — claude CLI (recommended, available across all projects):
#   claude mcp add --scope user utmm -- sudo -n /opt/utmm/utmm --mcp
#
#   --scope user registers the server at user level in ~/.claude.json, so it's
#   available in ALL projects. Default --scope local is project-only.
#   Use `claude mcp list` to verify.
#
#   To update an existing registration:
#     claude mcp remove utmm
#     claude mcp add --scope user utmm -- sudo -n /opt/utmm/utmm --mcp
#
# Option B — manual JSON config:
#   Copy the JSON below into your MCP config. Note: project-level registrations
#   (--scope local/project) in ~/.claude.json take precedence over this file.
#
#   Config locations:
#     Claude Code:     ~/.claude/mcp.json  (user)  or  .mcp.json (project)
#     Claude Desktop:  ~/Library/Application Support/Claude/claude_desktop_config.json
#
# VERIFY
# -----------------------------------------------------------------------------
# After installation, verify the connection:
#   claude mcp list                    # should show "utmm: ... - Connected"
#
# Or test manually:
#   echo '{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"protocolVersion":"2024-11-05","capabilities":{},"clientInfo":{"name":"test","version":"1.0"}}}' | sudo -n /opt/utmm/utmm --mcp
#
# HOW IT WORKS
# -----------------------------------------------------------------------------
# utmm --mcp starts a stdio MCP server. On first use:
#   1. Checks if Host service is running → if not, auto-installs + auto-starts
#   2. Reads JSON-RPC from stdin, writes responses to stdout (newline-delimited)
#   3. Tool calls talk to the Host daemon via local IPC socket (/var/run/utmm.sock)
#
# TROUBLESHOOTING
# -----------------------------------------------------------------------------
# | Symptom                              | Fix                                |
# |--------------------------------------|------------------------------------|
# | "No VMs online"                      | Boot the VMs, start utmm inside each |
# | "Failed to reconnect: -32000"        | Check `claude mcp list` — may have  |
# |                                      | stale registration. Remove & re-add:|
# |                                      | `claude mcp remove utmm`            |
# |                                      | `claude mcp add --scope user ...`   |
# | MCP tools not showing in Claude      | Restart Claude Code after config    |
# |                                      | change; verify with `claude mcp list`|
# | utmm --mcp hangs                     | Ensure stdin is not a TTY (piped)   |
# | "Root privileges required"           | Must run via sudo; add -n flag for  |
# |                                      | non-interactive (passwordless) mode |
# =============================================================================

{
  "mcpServers": {
    "utmm": {
      "command": "sudo",
      "args": ["-n", "/opt/utmm/utmm", "--mcp"]
    }
  }
}
