# MCP Server Configuration for utmm
# =============================================================================
# v0.18.0+: MCP is served directly by the Host daemon via HTTP POST on TCP :2121.
# No separate MCP process, no IPC bridge, no idle timeout, no buffer truncation.
#
# PREREQUISITES
# -----------------------------------------------------------------------------
# 1. utmm Host daemon must be installed and running:
#       sudo utmm --host --install   # one-time setup, survives reboots
#       sudo utmm --status           # verify Host is "serving"
#
# 2. utmm --mcp can be used to print the endpoint URL and ensure the Host:
#       utmm --mcp                   # prints: MCP endpoint: http://127.0.0.1:{port}/
#
# QUICK INSTALL (Claude Code)
# -----------------------------------------------------------------------------
# HTTP transport (v0.18.0+, recommended):
#   claude mcp add --transport http --scope user utmm http://127.0.0.1:2121/
#
#   To update an existing stdio registration (pre-v0.18.0):
#     claude mcp remove utmm
#     claude mcp add --transport http --scope user utmm http://127.0.0.1:2121/
#
# CONFIG FILES
# -----------------------------------------------------------------------------
#   Claude Code:     ~/.claude/mcp.json  (user)  or  .mcp.json (project)
#   Claude Desktop:  ~/Library/Application Support/Claude/claude_desktop_config.json
#
# VERIFY
# -----------------------------------------------------------------------------
# After installation, verify the connection:
#   claude mcp list                    # should show "utmm: http://127.0.0.1:2121/ (HTTP) - Connected"
#
# Or test manually:
#   curl -X POST http://127.0.0.1:2121/ -H 'Content-Type: application/json' \
#     -d '{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"protocolVersion":"2024-11-05","capabilities":{},"clientInfo":{"name":"test","version":"1.0"}}}'
#
# HOW IT WORKS (v0.18.0+)
# -----------------------------------------------------------------------------
# The Host daemon listens on TCP :2121 for both SOCKS5 and HTTP MCP (first-byte
# dispatch: 0x05→SOCKS5, ASCII→HTTP MCP). Each HTTP request is a single
# JSON-RPC call — one request, one response, then close. No keep-alive.
# The Host daemon auto-starts on boot (launchd/systemd/sc.exe), so the MCP
# endpoint is always available without any separate process.
#
# TROUBLESHOOTING
# -----------------------------------------------------------------------------
# | Symptom                              | Fix                                |
# |--------------------------------------|------------------------------------|
# | MCP not connecting                   | sudo utmm --host --install         |
# |                                      | (Host daemon not running)          |
# | "No VMs online"                      | Boot the VMs, start utmm inside each|
# | MCP tools not showing in Claude      | Restart Claude Code after config    |
# |                                      | change; verify with `claude mcp list`|
# =============================================================================

{
  "mcpServers": {
    "utmm": {
      "type": "http",
      "url": "http://127.0.0.1:2121/"
    }
  }
}
