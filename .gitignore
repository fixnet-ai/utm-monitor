# =============================================================================
# UTM Monitor — .gitignore
# =============================================================================

# ── Zig build artifacts ──────────────────────────────────────────────────
.zig-cache/
zig-out/

# ── Release artifacts ────────────────────────────────────────────────────
release/
utmm.zip

# ── IDE / editor ─────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── OS files ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Local dev files (not tracked) ────────────────────────────────────────
utm-monitor.conf
gw.txt
mcp.json
.playwright-mcp/
http-migration-plan.md

# ── Test outputs (generated at runtime, not tracked) ─────────────────────
# test_all.sh produces test_report.txt; other test artifacts match test_*
test_report.txt
test_write.o

# ── Claude Code local config ─────────────────────────────────────────────
# .claude/ contains mcp.json symlinks + session data — local-only
.claude/

# ═════════════════════════════════════════════════════════════════════════
# NOTE: test_all.sh is TRACKED (build verification script).
#       task_plan.md, findings.md, progress.md are TRACKED (project docs).
#       Do NOT add wildcard patterns that would ignore tracked files —
#       git won't ignore them, but it creates confusion.
# ═════════════════════════════════════════════════════════════════════════
utmm.lock
